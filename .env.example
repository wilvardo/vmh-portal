HOST=127.0.0.1
# 3002 deja libres el 3000 del sitio publico y el 3001 del panel: los tres se
# levantan a la vez contra el mismo API. Es tambien el puerto que espera
# PORTAL_URL en el entorno del API, de donde salen los enlaces de los correos.
PORT=3002
# URL de vmh-api. El portal es una SPA: todo lo declarado en runtimeConfig.public
# viaja al navegador. Aqui NUNCA van secretos ni llaves de servicio.
BASE_API_PATH="http://127.0.0.1:3399/api"

# URL del sitio publico. El portal la usa para mandar a contratar a quien
# todavia no tiene membresia y para enlazar el aviso de privacidad y los
# terminos. Vacia, esos enlaces no se pintan.
SITE_BASE_URL="http://127.0.0.1:3000"
