{
  "name": "vmh-portal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint:styles": "stylelint \"app/**/*.scss\"",
    "lint:styles:fix": "stylelint \"app/**/*.scss\" --fix",
    "lint:terminology": "node scripts/lint-terminology.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "validate": "pnpm lint && pnpm lint:styles && pnpm lint:tokens && pnpm lint:terminology && pnpm check:conventions && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "pwa:icons": "pwa-assets-generator --config pwa-assets.config.ts && mv pwa/*.png pwa/*.ico public/pwa/ 2>/dev/null || true"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.4.0",
    "@primevue/themes": "^4.5.4",
    "nuxt": "^4.4.8",
    "ofetch": "^1.5.1",
    "primevue": "^4.5.5",
    "socket.io-client": "4.8.3",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@csstools/postcss-global-data": "^4.0.0",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@primevue/nuxt-module": "^4.5.5",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.0",
    "eslint-plugin-jsdoc": "^63.0.12",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss-custom-media": "^12.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "stylelint": "^17.14.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6"
  }
}
